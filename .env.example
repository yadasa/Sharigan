# Sharingan: enter your own keys privately in .env.
# Direct BytePlus ModelArk API key, not an access-key/secret-key pair.
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=dreamina-seedance-2-5-260628
# Preparation: hosted vocal separation, depth and SAM.
REPLICATE_API_TOKEN=
# Optional Hugging Face depth alternative.
HF_TOKEN=
# Public media hosting for Seedance input URLs.
MEDIA_HOST=tmpfiles
# Opt in to persistent public fallback hosting by setting catbox.
MEDIA_HOST_FALLBACKS=
CATBOX_USERHASH=
